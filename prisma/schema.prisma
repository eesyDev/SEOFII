generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  plan          Plan          @default(FREE)
  reportsUsed   Int           @default(0)
  reportsLimit  Int?          @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  emailVerified DateTime?
  image         String?
  password      String?
  isAdmin       Boolean       @default(false)
  accounts      Account[]
  projects      Project[]
  reports       Report[]
  sessions      Session[]
  subscription  Subscription?
  monitors      PageMonitor[]
  sites         SiteConnection[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  plan             Plan
  status           SubscriptionStatus @default(ACTIVE)
  lemonSqueezyId   String?            @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  domain    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   Report[]
  sites     SiteConnection[]

  @@index([userId])
  @@map("projects")
}

model Report {
  id           String       @id @default(cuid())
  userId       String
  projectId    String?
  url          String
  status       ReportStatus @default(PENDING)
  result       Json?
  costUsd      Decimal?     @db.Decimal(8, 6)
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  gscData      Json?
  locationCode Int          @default(2840)
  competitors  Competitor[]
  keywords     Keyword[]
  monitor      PageMonitor?
  project      Project?     @relation(fields: [projectId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([projectId])
  @@map("reports")
}

model Competitor {
  id        String   @id @default(cuid())
  reportId  String
  domain    String
  position  Int
  title     String
  url       String
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, position])
  @@map("competitors")
}

model Keyword {
  id          String   @id @default(cuid())
  reportId    String
  keyword     String
  volume      Int      @default(0)
  cpc         Decimal  @default(0) @db.Decimal(8, 2)
  competition Decimal  @default(0) @db.Decimal(5, 4)
  createdAt   DateTime @default(now())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("keywords")
}

model PageMonitor {
  id        String               @id @default(cuid())
  userId    String
  reportId  String               @unique
  url       String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  report    Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  snapshots PageSnapshotRecord[]
  changes   DetectedChange[]
  outcomes  RankingOutcome[]

  @@index([userId, isActive])
  @@index([url])
  @@map("page_monitors")
}

model PageSnapshotRecord {
  id             String      @id @default(cuid())
  monitorId      String
  takenAt        DateTime    @default(now())
  wordCount      Int
  title          String
  h1             String
  headings       String[]
  detectedBlocks String[]
  schemaTypes    String[]
  internalLinks  Int
  monitor        PageMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, takenAt])
  @@map("page_snapshot_records")
}

model DetectedChange {
  id          String          @id @default(cuid())
  monitorId   String
  detectedAt  DateTime        @default(now())
  changeType  String
  field       String
  valueBefore String
  valueAfter  String
  monitor     PageMonitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  outcomes    RankingOutcome[]

  @@index([monitorId, detectedAt])
  @@map("detected_changes")
}

model RankingOutcome {
  id              String          @id @default(cuid())
  monitorId       String
  changeId        String?
  keyword         String
  positionBefore  Float
  positionAfter   Float
  delta           Float
  daysAfterChange Int
  measuredAt      DateTime        @default(now())
  monitor         PageMonitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  change          DetectedChange? @relation(fields: [changeId], references: [id])

  @@index([monitorId])
  @@index([changeId])
  @@map("ranking_outcomes")
}

model NichePattern {
  id          String   @id @default(cuid())
  niche       String
  pattern     String
  patternType String   @default("block")
  frequency   Float
  evidence    String[]
  confidence  String   @default("pending")
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pageType    String   @default("home")

  @@index([niche, pageType, confidence, frequency])
  @@map("niche_patterns")
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

model SiteConnection {
  id            String         @id @default(cuid())
  userId        String
  projectId     String?
  type          SiteType       @default(WORDPRESS)
  url           String
  credentials   Json?          // { username, appPassword, apiToken }
  isActive      Boolean        @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id])
  pages         SitePage[]
  jobs          AutoPilotJob[]
  config        AutoPilotConfig?

  @@index([userId, isActive])
  @@map("site_connections")
}

model SitePage {
  id          String   @id @default(cuid())
  siteId      String
  wpId        Int?     // WordPress post/page ID
  url         String
  title       String?
  content     String?  @db.Text
  excerpt     String?  @db.Text
  status      String   @default("publish") // publish, draft, etc.
  type        String   @default("page")    // post, page, product
  modifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        SiteConnection @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@unique([siteId, url])
  @@map("site_pages")
}

model AutoPilotConfig {
  id                String   @id @default(cuid())
  siteId            String   @unique
  autoApproveMeta   Boolean  @default(false)  // auto-approve title/meta changes
  autoApproveSchema Boolean  @default(false)  // auto-approve schema changes
  autoApproveFaq    Boolean  @default(false)  // auto-approve FAQ additions
  autoApproveContent Boolean @default(false)  // auto-approve content changes
  maxChangesPerWeek Int      @default(10)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  site              SiteConnection @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("autopilot_configs")
}

model AutoPilotJob {
  id          String          @id @default(cuid())
  siteId      String
  status      AutoPilotStatus @default(PENDING)
  targetUrl   String?
  pageCount   Int             @default(0)
  changeCount Int             @default(0)
  result      Json?
  errorMessage String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  site        SiteConnection  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  changes     AutoPilotChange[]

  @@index([siteId, status])
  @@map("autopilot_jobs")
}

model AutoPilotChange {
  id            String              @id @default(cuid())
  jobId         String
  pageUrl       String
  wpPostId      Int?                // WordPress post ID for applying
  field         String              // title, meta_description, content, schema, faq, heading
  oldValue      String?             @db.Text
  newValue      String              @db.Text
  aiReasoning   String?             @db.Text
  instruction   String?             @db.Text // what to add/change (NOT generated text)
  missingElements Json?               // array of { element, example, competitorDomain }
  evidence      Json?               // concrete data: competitor name, metric, before/after
  confidence    Int?                @default(50) // 0-100 score
  status        AutoPilotChangeStatus @default(PENDING)
  appliedAt     DateTime?
  rolledBackAt  DateTime?
  rankingBefore Float?
  rankingAfter  Float?
  createdAt     DateTime            @default(now())
  job           AutoPilotJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([pageUrl])
  @@map("autopilot_changes")
}

enum SiteType {
  WORDPRESS
  SHOPIFY
  WEBFLOW
  WIX
  CUSTOM
}

enum AutoPilotStatus {
  PENDING
  ANALYZING
  CHANGES_READY
  APPLYING
  DONE
  FAILED
}

enum AutoPilotChangeStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  ROLLED_BACK
}

enum ReportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
